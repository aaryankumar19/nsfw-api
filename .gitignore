# ==============================================================================
# FILE: .gitignore
# DESCRIPTION: Git ignore specifications for the nsfw-api repository.
# 
# WHAT THIS FILE DOES:
# - Excludes local development secrets (.env).
# - Excludes Cloudflare Wrangler state and local persistence caches (.wrangler/).
# - Excludes Python bytecode and caches (__pycache__/).
# - Excludes node_modules and OS-specific files.
# ==============================================================================

# Environment files containing secrets
.env
.env.local
.env.*.local

# Cloudflare Pages / Wrangler local state
.wrangler/
node_modules/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS and Editor metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Large uncompressed source file (kept compressed as data/domains.txt.gz for Cloudflare Pages 25MB limit)
data/domains.txt
public/api/v1/releases/*.json
!public/api/v1/releases/*.json.gz
public/api/v1/domains.json

