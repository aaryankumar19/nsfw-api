# ==============================================================================
# FILE: .env.example
# DESCRIPTION: Template for environment variables used by Cloudflare Pages & local dev.
# 
# WHAT THIS FILE DOES:
# - Documents the required secret environment variable: API_SECRET_KEY.
# - For Cloudflare Pages production/preview deployments:
#   Set this variable in Cloudflare Dashboard -> Workers & Pages -> <your-project>
#   -> Settings -> Environment variables -> Production & Preview.
# - For local development:
#   Copy this file to '.env' and set your local testing secret key.
# ==============================================================================

# Shared secret key required to access the NSFW Blocklist API endpoints
API_SECRET_KEY=your-secure-secret-key-here
